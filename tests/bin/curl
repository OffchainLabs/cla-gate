#!/usr/bin/env bash
# Stands in for curl in the gate. For the OIDC token request it prints a token, fails if
# $FAIL_OIDC is set, or returns a response without one if $OIDC_NO_VALUE is set. For the membership check it prints the HTTP status the members API would
# return: 204 for logins in $ORG_MEMBERS (case-insensitive), 404 otherwise, 401 for any token but
# $VALID_TOKEN, or $MEMBERS_HTTP if set, and records each login checked in $CURL_LOG.
set -euo pipefail

url=${*: -1}

if [[ -n "${ACTIONS_ID_TOKEN_REQUEST_URL:-}" && "$url" == "$ACTIONS_ID_TOKEN_REQUEST_URL"* ]]; then
  if [[ -n "${FAIL_OIDC:-}" ]]; then
    echo "curl: (22) The requested URL returned error: 500" >&2
    exit 22
  fi
  if [[ -n "${OIDC_NO_VALUE:-}" ]]; then
    echo '{}'
    exit
  fi
  echo '{"value":"fake-oidc-token"}'
  exit
fi

prefix="https://api.github.com/orgs/OffchainLabs/members/"
if [[ "$url" != "$prefix"* ]]; then
  echo "curl stub: unexpected URL: $url" >&2
  exit 1
fi
login=${url#"$prefix"}
echo "$login" >>"$CURL_LOG"

# Like real curl, read brackets as a URL pattern unless told not to.
if [[ "$url" == *"["* && " $* " != *" --globoff "* && " $* " != *" -g "* ]]; then
  echo "curl: (3) bad range in URL" >&2
  exit 3
fi

if [[ -n "${MEMBERS_HTTP:-}" ]]; then
  echo "$MEMBERS_HTTP"
  [[ "$MEMBERS_HTTP" != 000 ]]
  exit
fi
if [[ "$*" != *"Authorization: Bearer $VALID_TOKEN"* ]]; then
  echo 401
  exit
fi
for member in $ORG_MEMBERS; do
  if [[ "${member,,}" == "${login,,}" ]]; then
    echo 204
    exit
  fi
done
echo 404
